BOT_TOKEN=your_bot_token

# LLM provider: openai | ollama | deepseek
LLM_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# When LLM_PROVIDER=ollama:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma4:31b
# OLLAMA_API_KEY=ollama
# LLM_TIMEOUT_SECONDS=120

# When LLM_PROVIDER=deepseek:
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Telegram admin who receives new orders (required).
# For submit E2E: set to the bench test account id from `food-order-bench whoami`
ADMIN_TELEGRAM_ID=123456789

# food-order-bench (E2E via Telethon) — use a DEDICATED TEST account only
# Get api_id/api_hash at https://my.telegram.org
# TG_API_ID=12345
# TG_API_HASH=your_api_hash
# TG_SESSION=bench.session
# BOT_USERNAME=your_bot_username
# Then: food-order-bench whoami  →  ADMIN_TELEGRAM_ID=<id>  →  restart bot

# PostgreSQL FeedMer cafes (optional; falls back to CAFES_CONFIG_PATH)
DATABASE_URL=postgresql://user:pass@host:5432/feedmer
# Optional filter: only these cafeIds
# CAFE_IDS=67,68,69

# Google Sheets — FeedMer cafe spreadsheet (ssBackId)
SPREADSHEET_ID=your_spreadsheet_id
# Service account as JSON string (FeedMer style) OR path to file
API_SHEETS_GOOGLE_KEY = your_google_service_account_json
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Cafe / POS (optional price sync from RKeeper/Headline sheet)
CAFE_ID=68
SS_PRICELIST_ID=
POS_SYNC_ENABLED=false

# Paths
ORDER_SCHEMA_PATH=config/order_schema.yaml
CAFES_CONFIG_PATH=config/cafes.yaml
MENU_ALIASES_PATH=config/menu_aliases.yaml
MENU_CACHE_TTL_SECONDS=900
# Last N dialog messages kept for the LLM (0 disables history)
DIALOG_HISTORY_LIMIT=6
